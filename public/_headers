# Cloudflare Pages config
# collectors-canyon

[build]
  command = ""
  directory = /public

# Redirects
/watchlist /
/about /#about
/contact /#contact
/services /#services

# Headers for caching
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
